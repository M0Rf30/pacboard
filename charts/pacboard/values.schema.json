{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "namespaces": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}},
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["none", "github"]},
        "github": {
          "type": "object",
          "properties": {
            "url": {"type": "string", "pattern": "^https?://"},
            "allowedOrgs": {"type": "array", "items": {"type": "string"}},
            "publicUrl": {"type": "string"},
            "existingSecret": {"type": "string"}
          }
        }
      }
    },
    "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]}
  }
}
